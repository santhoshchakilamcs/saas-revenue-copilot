# Copy to .env and change every value. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=30
# Demo users are created from these at startup (bcrypt-hashed in memory).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=change-me
# Agent backend: "offline" (deterministic, no LLM, no key) or "ollama" (local model, no key)
AGENT_BACKEND=offline
OLLAMA_MODEL=llama3.2
# Answers below this confidence are auto-flagged for human review
REVIEW_CONFIDENCE_THRESHOLD=0.7
